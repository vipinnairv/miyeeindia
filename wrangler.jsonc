// Cloudflare Workers deployment for the MiyeeIndia Tech Labs site.
// The site is plain static HTML/CSS/JS, served as Workers static assets.
{
  "name": "miyeetechlabs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true
}
